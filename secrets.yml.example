# secrets.yml.example — template for GetConfigs.sh password-based devices
#
# Some devices (e.g. behind RADIUS/AD auth) can't use SSH keys and need a
# real username/password instead. For those, set "auth: password" on the
# device in devices.yml, then put the password here, keyed by device name.
#
# Setup:
#   cp secrets.yml.example secrets.yml
#   chmod 600 secrets.yml
#   <fill in real passwords>
#
# secrets.yml is gitignored — never commit it with real passwords in it.
# Format: <device name from devices.yml>: <password>   (no quotes, one per line)

secrets:
  RT03: change-me
