# Network Device Inventory — template
#
# This file is tracked in git and never edited directly. On first install
# it's copied to devices.yml (gitignored, local-only) — edit that one, or
# use add-device.sh. Keeping devices.yml out of git means `update.sh` /
# `git pull` can never overwrite or conflict with your real device list.
#
# Fields:
#   name      — display name (used in logs and commit messages)
#   ip        — device IP address
#   type      — device type: "cisco" (fetches running-config)
#               or "pfsense" (fetches /cf/conf/config.xml)
#   username  — SSH username (optional, defaults to: admin)
#   auth      — "key" (default) or "password". Use "password" for devices
#               that can't use SSH keys (e.g. RADIUS/AD-backed login) — the
#               actual password goes in secrets.yml, keyed by device name.
#               See secrets.yml.example.
#   enabled   — true (default) or false. Set false to keep a device listed
#               but skip it during backup (e.g. decommissioned, temporarily
#               unreachable) without deleting its config.
#   filename  — local filename to save the config as

devices:
#  - name: RT01
#    ip: 192.168.99.2
#    type: cisco
#    username: admin
#    filename: rt01.conf

#  - name: SW01
#    ip: 192.168.99.3
#    type: cisco
#    filename: sw01.conf

#  - name: FW01
#    ip: 192.168.99.1
#    type: pfsense
#    username: admin
#    filename: fw01.xml

#  - name: RT03
#    ip: 192.168.99.11
#    type: cisco
#    username: svc-netconfig     # dedicated AD account, checked via RADIUS
#    auth: password              # password lives in secrets.yml, not here
#    filename: rt03.conf

#  - name: SW02
#    ip: 192.168.99.4
#    type: cisco
#    enabled: false               # decommissioned — kept for reference, skipped by GetConfigs.sh
#    filename: sw02.conf
